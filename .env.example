GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=

# Opsional: lokasi file database SQLite (default lokal: extra.db di root proyek)
# Di Docker Compose otomatis ditimpa menjadi /app/data/extra.db agar persisten di volume ./data
# Mendukung alias opsional DB_PATH jika DATABASE_PATH tidak diisi
DATABASE_PATH=
