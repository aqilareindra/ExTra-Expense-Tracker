GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=

# Autentikasi Multi-User (M3.2)
JWT_SECRET=change_this_to_a_strong_random_secret_at_least_32_chars
JWT_EXPIRE_MINUTES=1440
COOKIE_SECURE=false

# Database: kosongkan DATABASE_URL untuk memakai SQLite lokal (extra.db / DATABASE_PATH)
# Isi DATABASE_URL untuk memakai PostgreSQL, misal: postgresql+psycopg://extra_user:extra_dev_password@localhost:5432/extra_db
DATABASE_URL=
DATABASE_PATH=

# Opsional untuk Docker Compose PostgreSQL
POSTGRES_USER=extra_user
POSTGRES_PASSWORD=extra_dev_password
POSTGRES_DB=extra_db
